# STORM Environment Configuration

# Frontend API URL (defaults to http://localhost:3001 if omitted)
VITE_API_URL=http://localhost:3001
APP_URL=http://localhost:5173

# Backend Server Port (defaults to 3001 if omitted)
PORT=3001

# Google Gemini API Key for AI Analysis
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication
JWT_SECRET=replace_me_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Twilio SMS Notifications (Optional / Production)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+15005550006
